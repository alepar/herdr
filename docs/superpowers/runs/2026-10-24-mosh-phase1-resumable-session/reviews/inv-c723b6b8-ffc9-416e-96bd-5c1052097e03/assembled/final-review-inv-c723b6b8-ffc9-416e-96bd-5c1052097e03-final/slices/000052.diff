+//! Saved machines, multiple clients, client exit and ghost eviction over a fake ssh
+//! (mosh-dqw.9).
+
+#![cfg(unix)]
+
+#[path = "mosh_harness.rs"]
+pub mod mosh_harness;
+pub mod support;
+
+use std::time::{Duration, Instant};
+
+use mosh_harness::{knob, Client, ClientOptions, Remote};
+
+const READY: Duration = Duration::from_secs(30);
+
+fn wait(predicate: impl FnMut() -> bool) -> bool {
+    mosh_harness::wait_for(READY, predicate)
+}
+
+fn sleep_ms(ms: u64) {
+    std::thread::sleep(Duration::from_millis(ms));
+}
+
+fn fail_context(remote: &Remote, client: &Client) -> String {
+    format!(
+        "screen:\n{}\nlocal: {:?}\nkeeper: {:?}\nlegs: {:?}\nplain: {:?}",
+        client.screen(),
+        client.events(),
+        remote.keeper_events(),
+        remote.session_legs(&client.id),
+        remote.plain_bridges(&client.id)
+    )
+}
+
+/// A saved-machine client whose remote endpoint is fully active: input typed into the TUI has
+/// reached the remote pane (activation still in flight would be torn by an early outage).
+fn saved(remote: &Remote, opts: &ClientOptions) -> Client {
+    let mut client = remote.spawn_saved_client(opts);
+    client.wait_attached(remote, READY);
+    assert!(
+        remote.wait_leg_count(&client.id, 1, READY),
+        "no session leg started"
+    );
+    // Input is dropped until activation finishes, so keep typing until it lands.
+    let tag = format!("up-{}", client.id);
+    assert!(
+        mosh_harness::wait_until(READY, Duration::from_millis(500), || {
+            if marks(remote).contains(&format!("MK{tag}")) {
+                return true;
+            }
+            type_mark(&mut client, &tag);
+            false
+        }),
+        "{}",
+        fail_context(remote, &client)
+    );
+    client
+}
+
+fn type_mark(client: &mut Client, tag: &str) {
+    client.type_mark(tag);
+}
+
+fn marks(remote: &Remote) -> Vec<String> {
+    remote.marks()
+}
+
+fn session_ends(remote: &Remote, reason: &str) -> usize {
+    remote
+        .keeper_events()
+        .iter()
+        .filter(|e| e["event"] == "session_end" && e["reason"] == reason)
+        .count()
+}
+
+/// Sessions the keeper still holds: created minus ended.
+fn live_sessions(remote: &Remote) -> isize {
+    remote.keeper_event_count("server_connect") as isize
+        - remote.keeper_event_count("session_end") as isize
+}
+
+fn saved_screen_never_unavailable(client: &Client) -> bool {
+    let screen = client.screen();
+    !screen.contains("unavailable") && !screen.contains("Action interrupted")
+}
+
+#[test]
+fn saved_outage_past_the_health_timeout_keeps_the_endpoint() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(120));
+
+    // Every reconnect leg fails, so the outage outlasts the client's 10 s health expiry.
+    remote.set_knob(knob::EOF_WELCOME, "");
+    remote.signal_leg(&client.id, libc::SIGKILL);
+    assert!(
+        client.wait_screen("unreachable", READY),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    for _ in 0..14 {
+        sleep_ms(1000);
+        assert!(
+            saved_screen_never_unavailable(&client),
+            "{}",
+            fail_context(&remote, &client)
+        );
+        assert_eq!(
+            client.event_count("session_end"),
+            0,
+            "{}",
+            fail_context(&remote, &client)
+        );
+    }
+    assert!(
+        remote.plain_bridges(&client.id).is_empty(),
+        "supervisor fell back: {}",
+        fail_context(&remote, &client)
+    );
+
+    remote.clear_knob(knob::EOF_WELCOME);
+    assert!(
+        client.wait_event("welcome", 2, Duration::from_secs(30)),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    assert!(client.has_welcome("resumed"));
+    type_mark(&mut client, "after-outage");
+    assert!(
+        wait(|| marks(&remote).contains(&"MKafter-outage".to_owned())),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    assert_eq!(
+        remote.keeper_event_count("server_connect"),
+        1,
+        "a reconnect opened a second server connection"
+    );
+    assert_eq!(client.event_count("session_end"), 0);
+    assert!(remote.plain_bridges(&client.id).is_empty());
+}
+
+#[test]
+fn saved_leg_stalling_right_after_a_health_ping_does_not_expire_the_endpoint() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(120));
+    // The client pings 5 s after the last server message. Make a server message, then stall the
+    // leg a hair before, at and after that ping, so the stall lands at every point of the 10 s
+    // health window.
+    for (round, offset_ms) in [4600u64, 5100, 5600].into_iter().enumerate() {
+        let before = client.event_count("welcome");
+        remote.pane_run(&format!("printf 'ROUND_%s\\n' {round}"));
+        assert!(client.wait_screen(&format!("ROUND_{round}"), READY));
+        sleep_ms(offset_ms);
+        remote.signal_leg(&client.id, libc::SIGSTOP);
+        assert!(
+            client.wait_event("welcome", before + 1, Duration::from_secs(40)),
+            "round {round} never resumed: {}",
+            fail_context(&remote, &client)
+        );
+        assert_eq!(
+            client.event_count("session_end"),
+            0,
+            "round {round}: {}",
+            fail_context(&remote, &client)
+        );
+        assert!(
+            remote.plain_bridges(&client.id).is_empty(),
+            "round {round}: supervisor fell back"
+        );
+        assert!(
+            saved_screen_never_unavailable(&client),
+            "round {round}: {}",
+            client.screen()
+        );
+    }
+    type_mark(&mut client, "after-stalls");
+    assert!(
+        wait(|| marks(&remote).contains(&"MKafter-stalls".to_owned())),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    assert_eq!(remote.keeper_event_count("server_connect"), 1);
+}
+
+#[test]
+fn saved_grace_expiry_takes_the_supervisor_reconnect_path() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(5));
+
+    remote.set_knob(knob::EOF_RECONNECT, "");
+    remote.signal_leg(&client.id, libc::SIGKILL);
+    // Past the 5 s grace the bridge gives up; the supervisor then builds a new bridge and
+    // dials a fresh leg 0 (the knob spares leg 0), i.e. a second session.
+    assert!(
+        client.wait_event("session_end", 1, Duration::from_secs(45)),
+        "bridge never gave up: {}",
+        fail_context(&remote, &client)
+    );
+    assert!(
+        wait(|| remote.keeper_event_count("server_connect") == 2),
+        "no supervisor reconnect: {}",
+        fail_context(&remote, &client)
+    );
+    let tag = "after-reconnect";
+    assert!(
+        mosh_harness::wait_until(READY, Duration::from_millis(500), || {
+            if marks(&remote).contains(&format!("MK{tag}")) {
+                return true;
+            }
+            type_mark(&mut client, tag);
+            false
+        }),
+        "saved machine never recovered: {}",
+        fail_context(&remote, &client)
+    );
+    assert!(!client.exited());
+    assert_eq!(live_sessions(&remote), 1, "{:?}", remote.keeper_events());
+}
+
+#[test]
+fn two_clients_have_independent_sessions() {
+    let remote = Remote::start();
+    let opts = ClientOptions::grace(60);
+    let mut first = remote.spawn_remote_client(&opts);
+    first.wait_attached(&remote, READY);
+    let mut second = remote.spawn_remote_client(&opts);
+    second.wait_attached(&remote, READY);
+    assert!(
+        remote.wait_leg_count(&first.id, 1, READY) && remote.wait_leg_count(&second.id, 1, READY)
+    );
+    assert_eq!(
+        remote.keeper_pids().len(),
+        1,
+        "both clients share one keeper"
+    );
+    assert_eq!(remote.keeper_event_count("server_connect"), 2);
+
+    remote.signal_leg(&first.id, libc::SIGKILL);
+    assert!(
+        first.wait_event("welcome", 2, READY),
+        "{}",
+        fail_context(&remote, &first)
+    );
+    assert!(first.has_welcome("resumed"));
+    // Both clients drive the same pane, so type one at a time.
+    type_mark(&mut first, "first");
+    assert!(
+        wait(|| marks(&remote).contains(&"MKfirst".to_owned())),
+        "{}",
+        fail_context(&remote, &first)
+    );
+    type_mark(&mut second, "second");
+    assert!(
+        wait(|| marks(&remote).contains(&"MKsecond".to_owned())),
+        "{}",
+        fail_context(&remote, &second)
+    );
+    // The other client never noticed.
+    assert_eq!(
+        second.event_count("leg_down"),
+        0,
+        "{}",
+        fail_context(&remote, &second)
+    );
+    assert_eq!(second.event_count("welcome"), 1);
+    assert_eq!(remote.leg_pids(&second.id).len(), 1);
+    assert_eq!(
+        remote.keeper_event_count("server_connect"),
+        2,
+        "a resume reconnected to the server"
+    );
+}
