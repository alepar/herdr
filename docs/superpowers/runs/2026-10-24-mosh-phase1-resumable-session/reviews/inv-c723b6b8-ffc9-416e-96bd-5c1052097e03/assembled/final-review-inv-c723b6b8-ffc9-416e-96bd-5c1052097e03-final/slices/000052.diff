+#[test]
+fn client_exit_ends_the_keeper_session_within_two_seconds() {
+    // The UI process dies while the leg is alive: the bridge sees a client EOF (and then the
+    // bridge is dropped, which sets should_stop). The keeper must hear END{client-gone}.
+    let remote = Remote::start();
+    let mut client = attached_remote(&remote);
+    let begin = Instant::now();
+    let ui = ui_child(client.pid().unwrap()).expect("the --remote client runs a UI child");
+    // SAFETY: the pid is a child of the client process this test started.
+    assert_eq!(unsafe { libc::kill(ui, libc::SIGKILL) }, 0);
+    assert!(
+        mosh_harness::wait_until(Duration::from_secs(2), Duration::from_millis(20), || {
+            session_ends(&remote, "client-gone") == 1
+        }),
+        "keeper session did not end with client-gone within 2 s ({:?} elapsed): {}",
+        begin.elapsed(),
+        fail_context(&remote, &client)
+    );
+    assert!(client.wait_exit(Duration::from_secs(10)));
+    assert_eq!(live_sessions(&remote), 0);
+}
+
+#[test]
+fn saved_machine_quit_ends_the_keeper_session_within_two_seconds() {
+    // Quitting the saved-machine client stops its in-process bridge (should_stop) while the
+    // leg is alive: END{client-gone} must reach the keeper at once. Repeated because the
+    // bridge's stop races the UI closing its socket.
+    for round in 0..4 {
+        let remote = Remote::start();
+        let mut client = saved(&remote, &ClientOptions::grace(60));
+        let begin = Instant::now();
+        client.type_keys("\x02q");
+        assert!(
+            mosh_harness::wait_until(Duration::from_secs(2), Duration::from_millis(20), || {
+                session_ends(&remote, "client-gone") == 1
+            }),
+            "round {round}: keeper session did not end with client-gone within 2 s ({:?} elapsed): {}",
+            begin.elapsed(),
+            fail_context(&remote, &client)
+        );
+        assert!(client.wait_exit(Duration::from_secs(10)), "round {round}");
+        assert_eq!(live_sessions(&remote), 0, "round {round}");
+    }
+}
+
+fn attached_remote(remote: &Remote) -> Client {
+    let client = remote.spawn_remote_client(&ClientOptions::grace(60));
+    client.wait_attached(remote, READY);
+    assert!(remote.wait_leg_count(&client.id, 1, READY));
+    client
+}
+
+/// Child of `parent` (the thin UI process a `--remote` client starts).
+fn ui_child(parent: u32) -> Option<libc::pid_t> {
+    for entry in std::fs::read_dir("/proc").ok()?.flatten() {
+        let Some(pid) = entry
+            .file_name()
+            .to_str()
+            .and_then(|n| n.parse::<libc::pid_t>().ok())
+        else {
+            continue;
+        };
+        let Ok(stat) = std::fs::read_to_string(entry.path().join("stat")) else {
+            continue;
+        };
+        // pid (comm) state ppid ...: comm may contain spaces, so split after the last ')'.
+        let fields: Vec<&str> = stat.rsplit_once(')')?.1.split_whitespace().collect();
+        let cmdline = std::fs::read(entry.path().join("cmdline")).unwrap_or_default();
+        if fields.get(1).and_then(|p| p.parse::<u32>().ok()) == Some(parent)
+            && String::from_utf8_lossy(&cmdline).contains("client")
+        {
+            return Some(pid);
+        }
+    }
+    None
+}
+
+#[test]
+fn saved_reconnect_through_the_same_path_evicts_the_parked_session() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(300));
+    assert_eq!(live_sessions(&remote), 1);
+
+    // Outage with the old session parked in the keeper. Reconnect legs fail but leg 0 works.
+    remote.set_knob(knob::EOF_RECONNECT, "");
+    remote.signal_leg(&client.id, libc::SIGKILL);
+    assert!(client.wait_event("leg_down", 1, READY));
+    // More input than the 8 MiB local ring holds ends the connection with the leg still down;
+    // the supervisor then reconnects through the same local socket path with previous_token.
+    for _ in 0..10 {
+        paste_mib(&mut client);
+    }
+    assert!(
+        client.wait_event("session_end", 1, Duration::from_secs(60)),
+        "local ring never overflowed: {}",
+        fail_context(&remote, &client)
+    );
+    assert!(
+        wait(|| session_ends(&remote, "evicted") == 1),
+        "the parked session was not evicted: {}",
+        fail_context(&remote, &client)
+    );
+    assert_eq!(remote.keeper_event_count("server_connect"), 2);
+    assert_eq!(live_sessions(&remote), 1, "{:?}", remote.keeper_events());
+    let tag = "after-eviction";
+    assert!(
+        mosh_harness::wait_until(READY, Duration::from_millis(500), || {
+            if marks(&remote).contains(&format!("MK{tag}")) {
+                return true;
+            }
+            type_mark(&mut client, tag);
+            false
+        }),
+        "{}",
+        fail_context(&remote, &client)
+    );
+}
+
+fn paste_mib(client: &mut Client) {
+    let block = format!("{}\n", "0123456789abcdef".repeat(4)).repeat(1024);
+    client.type_bytes(b"\x1b[200~");
+    for _ in 0..16 {
+        client.type_bytes(block.as_bytes());
+    }
+    client.type_bytes(b"\x1b[201~");
+}
+
+#[test]
+fn saved_live_handoff_reconnects_and_leaves_one_session() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(60));
+    let reply = remote
+        .request(serde_json::json!({"id":"handoff","method":"server.live_handoff","params":{}}));
+    assert!(reply.get("error").is_none(), "{reply}");
+    // Today's reconnect: the saved machine comes back through the same bridge socket.
+    assert!(
+        wait(|| remote.keeper_event_count("server_connect") == 2),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    let tag = "after-handoff";
+    assert!(
+        mosh_harness::wait_until(READY, Duration::from_millis(500), || {
+            if marks(&remote).contains(&format!("MK{tag}")) {
+                return true;
+            }
+            type_mark(&mut client, tag);
+            false
+        }),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    assert!(!client.exited());
+    assert!(
+        wait(|| live_sessions(&remote) == 1),
+        "{:?}",
+        remote.keeper_events()
+    );
+    assert!(!client.output_text().contains("lost connection"));
+}
+
+#[test]
+fn saved_request_buffered_past_the_command_timeout_executes_once_on_resume() {
+    let remote = Remote::start();
+    let mut client = saved(&remote, &ClientOptions::grace(240));
+    let tabs_before = remote.tab_count();
+
+    remote.set_knob(knob::EOF_WELCOME, "");
+    remote.signal_leg(&client.id, libc::SIGKILL);
+    assert!(
+        client.wait_screen("unreachable", READY),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    // Prefix + c, then Enter on the name prompt: an endpoint request that cannot reach the server.
+    client.type_keys("\x02c");
+    sleep_ms(1000);
+    client.type_keys("\r");
+    // ENDPOINT_COMMAND_TIMEOUT is 60 s: the request is stale before the leg returns.
+    assert!(
+        mosh_harness::wait_for(Duration::from_secs(90), || client
+            .screen()
+            .contains("did not respond")),
+        "the request never timed out client-side: {}",
+        fail_context(&remote, &client)
+    );
+    assert_eq!(
+        remote.tab_count(),
+        tabs_before,
+        "request executed during the outage"
+    );
+    assert!(!client.exited());
+
+    remote.clear_knob(knob::EOF_WELCOME);
+    assert!(
+        client.wait_event("welcome", 2, Duration::from_secs(30)),
+        "{}",
+        fail_context(&remote, &client)
+    );
+    assert!(
+        wait(|| remote.tab_count() == tabs_before + 1),
+        "tabs: {}",
+        remote.tab_count()
+    );
+    sleep_ms(3000);
+    assert_eq!(
+        remote.tab_count(),
+        tabs_before + 1,
+        "request executed more than once"
+    );
+    assert!(remote.plain_bridges(&client.id).is_empty());
+}
