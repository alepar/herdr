+    // ---- leg ownership and dial ------------------------------------------------------------
+
+    fn sh(script: &str) -> Command {
+        let mut command = Command::new("sh");
+        command.args(["-c", script]);
+        command
+    }
+
+    fn ready_script(rest: &str) -> String {
+        format!("{MARKER_PRINTF}; {rest}")
+    }
+
+    #[test]
+    fn leg_owns_child_exit_status_and_stderr() {
+        let script = ready_script("printf abc; echo oops >&2; exit 7");
+        let (leg, mut reader) = spawn_leg(sh(&script), true).unwrap();
+        attach::discard_remote_output_preamble(&mut reader).unwrap();
+        let mut rest = String::new();
+        reader.read_to_string(&mut rest).unwrap();
+        assert_eq!(rest, "abc");
+        let report = leg.finish(false);
+        assert_eq!(report.exit_status.and_then(|s| s.code()), Some(7));
+        assert_eq!(report.stderr.as_deref(), Some("oops\n"));
+        assert!(!report.killed_by_bridge);
+    }
