+    // ---- probe and re-selection ------------------------------------------------------------
+
+    fn status_json(capability: bool, generation: u32) -> RemoteClientStatusJson {
+        let mut caps = vec![
+            crate::protocol::endpoint::SURFACE_INTEREST_CAPABILITY,
+            crate::protocol::endpoint::PRESENTATION_EFFECTS_FENCE_CAPABILITY,
+            crate::protocol::endpoint::HEALTH_CHECK_CAPABILITY,
+        ];
+        if capability {
+            caps.push(super::super::STATUS_CAPABILITY);
+        }
+        attach::parse_client_status_json(
+            &serde_json::json!({
+                "version": "9.9.9",
+                "endpoint_protocol_generation": generation,
+                "endpoint_capabilities": caps,
+                "remote_bridge_idle_timeout": true,
+            })
+            .to_string(),
+        )
+        .unwrap()
+    }
+
+    fn good() -> u32 {
+        crate::protocol::endpoint::ENDPOINT_PROTOCOL_GENERATION
+    }
+
+    fn path_of(herdr: &RemoteHerdr) -> String {
+        herdr.resolved_executable.clone().unwrap()
+    }
+
+    /// Statuses keyed by resolved path; unknown paths answer `Ok(None)`.
+    fn select(
+        selected: &str,
+        candidates: &[&str],
+        table: Vec<(&str, io::Result<Option<RemoteClientStatusJson>>)>,
+    ) -> (io::Result<Option<RemoteHerdr>>, Vec<String>, bool) {
+        let mut table = table;
+        let mut probed = Vec::new();
+        let mut asked = false;
+        let result = select_with(
+            &herdr_at(selected),
+            |herdr| {
+                let path = path_of(herdr);
+                probed.push(path.clone());
+                match table.iter().position(|(p, _)| *p == path) {
+                    Some(i) => table.remove(i).1,
+                    None => Ok(None),
+                }
+            },
+            || {
+                asked = true;
+                Ok(candidates.iter().map(|p| herdr_at(p)).collect())
+            },
+        );
+        (result, probed, asked)
+    }
+
+    #[test]
+    fn capable_first_candidate() {
+        let (result, probed, asked) = select(
+            "/a/herdr",
+            &["/b/herdr"],
+            vec![("/a/herdr", Ok(Some(status_json(true, good()))))],
+        );
+        assert_eq!(path_of(&result.unwrap().unwrap()), "/a/herdr");
+        assert_eq!(probed, ["/a/herdr"]);
+        assert!(!asked, "candidates must not be discovered");
+    }
+
+    #[test]
+    fn upstream_first_skipped_for_capable_later() {
+        let (result, probed, _) = select(
+            "/a/herdr",
+            &["/a/herdr", "/b/herdr", "/c/herdr"],
+            vec![
+                ("/a/herdr", Ok(Some(status_json(false, good())))),
+                ("/b/herdr", Ok(Some(status_json(false, good())))),
+                ("/c/herdr", Ok(Some(status_json(true, good())))),
+            ],
+        );
+        let chosen = result.unwrap().unwrap();
+        assert_eq!(path_of(&chosen), "/c/herdr");
+        assert!(chosen.bridge_idle_timeout, "copied from the candidate's status");
+        assert_eq!(probed, ["/a/herdr", "/b/herdr", "/c/herdr"]);
+    }
+
+    #[test]
+    fn none_capable_is_plain() {
+        let (result, _, asked) = select(
+            "/a/herdr",
+            &["/b/herdr"],
+            vec![
+                ("/a/herdr", Ok(Some(status_json(false, good())))),
+                ("/b/herdr", Ok(None)),
+            ],
+        );
+        assert!(result.unwrap().is_none());
+        assert!(asked);
+    }
+
+    #[test]
+    fn wrong_generation_candidate_is_skipped() {
+        let (result, _, _) = select(
+            "/a/herdr",
+            &["/b/herdr", "/c/herdr"],
+            vec![
+                ("/b/herdr", Ok(Some(status_json(true, good() + 1)))),
+                ("/c/herdr", Ok(Some(status_json(true, good())))),
+            ],
+        );
+        assert_eq!(path_of(&result.unwrap().unwrap()), "/c/herdr");
+    }
+
+    #[test]
+    fn candidate_status_error_is_skipped_but_selected_error_propagates() {
+        let (result, _, _) = select(
+            "/a/herdr",
+            &["/b/herdr", "/c/herdr"],
+            vec![
+                ("/b/herdr", Err(io::Error::other("boom"))),
+                ("/c/herdr", Ok(Some(status_json(true, good())))),
+            ],
+        );
+        assert_eq!(path_of(&result.unwrap().unwrap()), "/c/herdr");
+
+        let (result, _, asked) = select(
+            "/a/herdr",
+            &["/c/herdr"],
+            vec![("/a/herdr", Err(io::Error::other("ssh down")))],
+        );
+        assert!(result.is_err());
+        assert!(!asked);
+    }
+
+    #[test]
+    fn windows_remote_is_plain_without_probing() {
+        let windows = RemoteHerdr::for_platform(RemotePlatform {
+            os: "windows",
+            arch: "x86_64",
+        });
+        let result = select_with(
+            &windows,
+            |_| panic!("must not probe a Windows remote"),
+            || panic!("must not discover candidates"),
+        );
+        assert!(result.unwrap().is_none());
+    }
