+//! Leg abstraction and its ssh implementation: per-leg command construction, spawn/kill,
+//! failure classification, reconnect back-off. Does not own session bytes.
+
+use super::super as attach;
+use attach::{ManagedSshOptions, RemoteClientStatusJson, RemoteHerdr, RemoteSsh};
+use std::io::{self, BufReader};
+use std::process::{ChildStdout, Command, ExitStatus, Stdio};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::mpsc;
+use std::thread;
+use std::time::{Duration, Instant};
+
+/// Which leg of a session is being dialed: leg 0 (first connection, today's options) or a
+/// reconnect leg (noninteractive, ControlMaster bypassed).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum LegKind {
+    Initial,
+    Reconnect,
+}
+
+/// Structured end report of one leg; classification input for `LegDialer::classify`.
+#[derive(Debug, Default)]
+pub(super) struct LegEndReport {
+    pub exit_status: Option<ExitStatus>,
+    /// Captured on reconnect legs only.
+    pub stderr: Option<String>,
+    pub welcome_reached: bool,
+    /// `END` reason seen before `WELCOME`.
+    pub pre_welcome_end: Option<String>,
+    /// Pre-`WELCOME` bound, setup deadline or stop.
+    pub killed_by_bridge: bool,
+}
+
+type Teardown = Box<dyn FnOnce(bool) -> (Option<ExitStatus>, Option<String>) + Send>;
+
+/// One live connection to the keeper side (transport-neutral).
+///
+/// Owns: a duplex byte stream, a teardown handle, and a structured end report (`ExitStatus`,
+/// captured stderr on reconnect legs, whether `WELCOME` was reached, any pre-`WELCOME` `END`
+/// reason). For ssh it owns the ssh child directly: no socketpair, no `bridge_child`.
+/// Hides: which process or transport carries the bytes.
+/// Must not: know session semantics (it never interprets bytes).
+/// Lifecycle: produced by a `LegDialer`, owned by the connection run; teardown kills the
+/// child on silence, protocol error or session end. Dropping an unfinished leg tears it down
+/// with `kill = true`.
+pub(super) struct Leg {
+    reader: Option<Box<dyn io::Read + Send>>,
+    writer: Option<Box<dyn io::Write + Send>>,
+    /// Argument: whether to kill the underlying process before reaping it.
+    teardown: Option<Teardown>,
+    welcome_reached: bool,
+    pre_welcome_end: Option<String>,
+}
+
+impl Leg {
+    #[cfg(test)]
+    pub(super) fn new(
+        reader: Box<dyn io::Read + Send>,
+        writer: Box<dyn io::Write + Send>,
+        teardown: Teardown,
+    ) -> Leg {
+        Leg {
+            reader: Some(reader),
+            writer: Some(writer),
+            teardown: Some(teardown),
+            welcome_reached: false,
+            pre_welcome_end: None,
+        }
+    }
+
+    /// Wrap a spawned child whose stdin/stdout are the leg's byte stream.
+    #[cfg(test)]
+    pub(super) fn from_child(mut child: std::process::Child) -> io::Result<Leg> {
+        let stdin = child
+            .stdin
+            .take()
+            .ok_or_else(|| io::Error::other("leg child has no stdin"))?;
+        let stdout = child
+            .stdout
+            .take()
+            .ok_or_else(|| io::Error::other("leg child has no stdout"))?;
+        Ok(Leg::new(
+            Box::new(stdout),
+            Box::new(stdin),
+            Box::new(move |kill| {
+                if kill {
+                    let _ = child.kill();
+                }
+                (child.wait().ok(), None)
+            }),
+        ))
+    }
+
+    /// The pumps run on separate threads, so each half is taken once.
+    pub(super) fn take_reader(&mut self) -> Option<Box<dyn io::Read + Send>> {
+        self.reader.take()
+    }
+
+    pub(super) fn take_writer(&mut self) -> Option<Box<dyn io::Write + Send>> {
+        self.writer.take()
+    }
+
+    pub(super) fn mark_welcome(&mut self) {
+        self.welcome_reached = true;
+    }
+
+    pub(super) fn record_pre_welcome_end(&mut self, reason: String) {
+        self.pre_welcome_end = Some(reason);
+    }
+
+    /// Tear the leg down (killing the process when `kill`) and return its end report.
+    pub(super) fn finish(mut self, kill: bool) -> LegEndReport {
+        let (exit_status, stderr) = match self.teardown.take() {
+            Some(teardown) => {
+                // Close our stream halves first so a child waiting on stdin can exit.
+                self.writer = None;
+                self.reader = None;
+                teardown(kill)
+            }
+            None => (None, None),
+        };
+        LegEndReport {
+            exit_status,
+            stderr,
+            welcome_reached: self.welcome_reached,
+            pre_welcome_end: self.pre_welcome_end.take(),
+            killed_by_bridge: kill,
+        }
+    }
+}
+
+impl Drop for Leg {
+    fn drop(&mut self) {
+        if let Some(teardown) = self.teardown.take() {
+            self.writer = None;
+            self.reader = None;
+            teardown(true);
+        }
+    }
+}
+
+/// Why a leg could not be made or ended, each carrying the error that explains it.
+/// `Retryable` (including silence or EOF before `WELCOME` on a reconnect leg, within the
+/// give-up deadline), `Fatal` (auth/host key at exit 255 on a reconnect leg, or a positive
+/// remote refusal), `Unsupported` (any remote-side failure before `WELCOME` on leg 0 only,
+/// which falls back to the plain bridge). Kept distinct.
+#[derive(Debug)]
+pub(super) enum LegError {
+    Retryable(io::Error),
+    Fatal(io::Error),
+    Unsupported(io::Error),
+}
+
+/// "Produce the next leg."
+///
+/// Owns (`SshLegDialer`, mosh-dqw.6): per-leg remote command via upstream builders, leg-0 vs
+/// reconnect options, the back-off schedule, and failure classification from the leg's end
+/// report. Hides: ssh arguments and ControlMaster bypass. Must not: touch session bytes or the
+/// give-up deadline (the caller owns the deadline and stop flag and stops dialing when either
+/// fires). A new transport is a new impl registered in `start_ui_bridge`; callers never build
+/// ssh commands.
+/// Lifecycle: created by `start_ui_bridge`, owned by the `LocalBridge` for the bridge's lifetime.
+pub(super) trait LegDialer: Send {
+    /// Spawn the next leg and return once its ready marker is consumed (the caller writes HELLO
+    /// immediately). `setup_deadline`: `None` on leg 0 (prompts may take arbitrarily long); on a
+    /// reconnect leg the caller passes `session::setup_deadline(now, give_up_at)`.
+    /// On deadline or `stop`, the child is killed and the result is `Retryable`.
+    fn dial(
+        &mut self,
+        kind: LegKind,
+        setup_deadline: Option<Instant>,
+        stop: &AtomicBool,
+    ) -> Result<Leg, LegError>;
+    /// Classify a finished leg from its structured end report.
+    fn classify(&self, kind: LegKind, end: &LegEndReport) -> LegError;
+    /// Delay before reconnect attempt `attempt` (0-based): 1, 2, 4, 8, 8... s.
+    fn backoff(&self, attempt: u32) -> Duration;
+}
+
+/// Spawn `command` as a leg: stdin/stdout piped (the leg's duplex stream), stderr piped and
+/// drained on a thread when `capture_stderr` (capped like `capture_ssh_stderr`), else as set on
+/// the command. Returns the leg (reader not yet attached) and the child's buffered stdout, so
+/// the caller can consume the ready marker before handing the same buffer to the leg.
+fn spawn_leg(
+    mut command: Command,
+    capture_stderr: bool,
+) -> io::Result<(Leg, BufReader<ChildStdout>)> {
+    command.stdin(Stdio::piped()).stdout(Stdio::piped());
+    if capture_stderr {
+        command.stderr(Stdio::piped());
+    }
+    let mut child = command.spawn()?;
+    let (Some(stdin), Some(stdout)) = (child.stdin.take(), child.stdout.take()) else {
+        let _ = child.kill();
+        let _ = child.wait();
+        return Err(io::Error::other("leg child has no piped stdio"));
+    };
+    let stderr_thread = child.stderr.take().map(|stderr| {
+        thread::spawn(move || attach::capture_ssh_stderr(stderr).unwrap_or_default())
+    });
+    let leg = Leg {
+        reader: None,
+        writer: Some(Box::new(stdin)),
+        teardown: Some(Box::new(move |kill| {
+            if kill {
+                let _ = child.kill();
+            }
+            let status = child.wait().ok();
+            let stderr = stderr_thread.map(|handle| {
+                String::from_utf8_lossy(&handle.join().unwrap_or_default()).into_owned()
+            });
+            (status, stderr)
+        })),
+        welcome_reached: false,
+        pre_welcome_end: None,
+    };
+    Ok((leg, BufReader::new(stdout)))
+}
+
+/// Classify a leg that ended before the session was established (or after, which is always
+/// retryable). A pure function of `kind` and the report; a leg torn down for stop or session
+/// end is not classified (the caller's job). Order: post-`WELCOME`, ssh-level failure
+/// (exit 255), explicit pre-`WELCOME` `END`, remote error exit, otherwise EOF/silence.
+pub(super) fn classify_leg(kind: LegKind, end: &LegEndReport) -> LegError {
+    let reconnect = kind == LegKind::Reconnect;
+    let code = end.exit_status.and_then(|status| status.code());
+    let stderr = end.stderr.as_deref().unwrap_or("");
+    if end.welcome_reached {
+        return LegError::Retryable(io::Error::other(format!(
+            "leg ended after WELCOME ({})",
+            describe_exit(end)
+        )));
+    }
+    if code == Some(255) && !end.killed_by_bridge {
+        if !reconnect {
+            let status = end.exit_status.expect("code implies status");
+            return LegError::Fatal(attach::ssh_bridge_exit_error(status, stderr.as_bytes()));
+        }
+        let evidence = format!("ssh failed (exit 255): {}", stderr.trim());
+        return if stderr.contains("Permission denied")
+            || stderr.contains("Host key verification failed")
+        {
+            LegError::Fatal(io::Error::other(evidence))
+        } else {
+            LegError::Retryable(io::Error::other(evidence))
+        };
+    }
+    if let Some(reason) = &end.pre_welcome_end {
+        let err = io::Error::other(format!("remote refused the session before WELCOME: {reason}"));
+        return if reconnect {
+            LegError::Fatal(err)
+        } else {
+            LegError::Unsupported(err)
+        };
+    }
+    if matches!(code, Some(c) if c != 0) && !end.killed_by_bridge {
+        let err = io::Error::other(format!(
+            "remote bridge failed before WELCOME ({}){}",
+            describe_exit(end),
+            if stderr.trim().is_empty() {
+                String::new()
+            } else {
+                format!(": {}", stderr.trim())
+            }
+        ));
+        return if reconnect {
+            LegError::Fatal(err)
+        } else {
+            LegError::Unsupported(err)
+        };
+    }
+    let err = io::Error::other(format!(
+        "leg ended before WELCOME ({})",
+        describe_exit(end)
+    ));
+    if reconnect {
+        LegError::Retryable(err)
+    } else {
+        LegError::Unsupported(err)
+    }
+}
+
+fn describe_exit(end: &LegEndReport) -> String {
+    let status = end
+        .exit_status
+        .map_or_else(|| "no exit status".to_owned(), |status| status.to_string());
+    if end.killed_by_bridge {
+        format!("{status}, killed by the bridge")
+    } else {
+        status
+    }
+}
+
+/// Ssh implementation of `LegDialer`: builds each leg's ssh command and owns the spawned child.
+pub(super) struct SshLegDialer {
+    target: String,
+    remote_command: String,
+    options: Option<ManagedSshOptions>,
+    noninteractive: bool,
+}
+
+impl SshLegDialer {
+    pub(super) fn new(
+        target: String,
+        remote_herdr: &RemoteHerdr,
+        session_name: &str,
+        options: Option<&ManagedSshOptions>,
+        noninteractive: bool,
+    ) -> Self {
+        let args = attach::RemoteExecutable::session_args(
+            session_name,
+            &["remote-client-bridge", super::SESSION_FLAG],
+        );
+        let remote_command = attach::posix_remote_output_command(&format!(
+            "exec {}",
+            remote_herdr.executable.command(&args)
+        ));
+        SshLegDialer {
+            target,
+            remote_command,
+            options: options.cloned(),
+            noninteractive,
+        }
+    }
+
+    /// Leg 0 mirrors `bridge_connection` exactly. Every reconnect leg is noninteractive and
+    /// bypasses any ControlMaster (never `-S`, `ControlPath=none`), whatever the config says.
+    fn leg_command(&self, kind: LegKind) -> Command {
+        let mut command = Command::new("ssh");
+        match kind {
+            LegKind::Initial => {
+                attach::apply_managed_ssh_options(&mut command, self.options.as_ref());
+                if self.noninteractive {
+                    attach::apply_noninteractive_ssh_options(&mut command);
+                }
+            }
+            LegKind::Reconnect => {
+                let no_master = self.options.as_ref().map(|options| ManagedSshOptions {
+                    control_path: None,
+                    ..options.clone()
+                });
+                attach::apply_managed_ssh_options(&mut command, no_master.as_ref());
+                attach::apply_noninteractive_ssh_options(&mut command);
+                command.args(["-o", "ControlPath=none", "-o", "ControlMaster=no"]);
+            }
+        }
+        command.arg("-T").arg(&self.target).arg(&self.remote_command);
+        command
+    }
+
+    /// Spawn `command` as a leg and wait for its ready marker, honouring `stop` and the setup
+    /// deadline. Split from `dial` so tests can drive it without ssh.
+    fn dial_command(
+        &self,
+        command: Command,
+        kind: LegKind,
+        setup_deadline: Option<Instant>,
+        stop: &AtomicBool,
+    ) -> Result<Leg, LegError> {
+        let capture = kind == LegKind::Reconnect || self.noninteractive;
+        let (mut leg, mut reader) = spawn_leg(command, capture)
+            .map_err(|err| LegError::Fatal(io::Error::new(err.kind(), format!("could not start ssh: {err}"))))?;
+        let (tx, rx) = mpsc::channel();
+        thread::spawn(move || {
+            let result = attach::discard_remote_output_preamble(&mut reader);
+            let _ = tx.send((result, reader));
+        });
+        loop {
+            if stop.load(Ordering::SeqCst) {
+                leg.finish(true);
+                return Err(LegError::Retryable(io::Error::other("leg dial stopped")));
+            }
+            if setup_deadline.is_some_and(|deadline| Instant::now() >= deadline) {
+                leg.finish(true);
+                return Err(LegError::Retryable(io::Error::other(
+                    "leg did not become ready before the setup deadline",
+                )));
+            }
+            match rx.recv_timeout(Duration::from_millis(100)) {
+                Ok((Ok(()), reader)) => {
+                    leg.reader = Some(Box::new(reader));
+                    return Ok(leg);
+                }
+                Ok((Err(_), _)) => {
+                    let report = leg.finish(false);
+                    return Err(self.classify(kind, &report));
+                }
+                Err(mpsc::RecvTimeoutError::Timeout) => {}
+                Err(mpsc::RecvTimeoutError::Disconnected) => {
+                    leg.finish(true);
+                    return Err(LegError::Retryable(io::Error::other(
+                        "leg marker reader ended unexpectedly",
+                    )));
+                }
+            }
+        }
+    }
+}
+
+impl LegDialer for SshLegDialer {
+    fn dial(
+        &mut self,
+        kind: LegKind,
+        setup_deadline: Option<Instant>,
+        stop: &AtomicBool,
+    ) -> Result<Leg, LegError> {
+        self.dial_command(self.leg_command(kind), kind, setup_deadline, stop)
+    }
+
+    fn classify(&self, kind: LegKind, end: &LegEndReport) -> LegError {
+        classify_leg(kind, end)
+    }
+
+    fn backoff(&self, attempt: u32) -> Duration {
+        Duration::from_secs(1 << attempt.min(3))
+    }
+}
+
+/// Probe the selected remote binary, then the other candidates, for the resume capability.
+/// `Ok(Some(h))`: resume with `h` (possibly a different candidate than `selected`);
+/// `Ok(None)`: plain. Silent: the caller prints the `HERDR_REMOTE_BINARY` hint.
+pub(super) fn select_resume_candidate(
+    ssh: &RemoteSsh,
+    selected: &RemoteHerdr,
+) -> io::Result<Option<RemoteHerdr>> {
+    select_with(
+        selected,
+        |herdr| attach::remote_client_status(ssh, herdr),
+        || attach::remote_binary_candidates(ssh, selected),
+    )
+}
+
+fn select_with(
+    selected: &RemoteHerdr,
+    mut status: impl FnMut(&RemoteHerdr) -> io::Result<Option<RemoteClientStatusJson>>,
+    candidates: impl FnOnce() -> io::Result<Vec<RemoteHerdr>>,
+) -> io::Result<Option<RemoteHerdr>> {
+    fn qualifies(herdr: &RemoteHerdr, status: &RemoteClientStatusJson) -> bool {
+        status
+            .endpoint_capabilities
+            .iter()
+            .any(|capability| capability == super::STATUS_CAPABILITY)
+            && status.supports_endpoint_requirement(&herdr.platform, true)
+    }
+
+    if selected.platform.is_windows() {
+        return Ok(None);
+    }
+    if let Some(found) = status(selected)? {
+        if qualifies(selected, &found) {
+            return Ok(Some(selected.clone()));
+        }
+    }
+    for mut candidate in candidates()? {
+        if candidate.executable == selected.executable {
+            continue; // already probed
+        }
+        if let Some(found) = status(&candidate).unwrap_or(None) {
+            if qualifies(&candidate, &found) {
+                candidate.bridge_idle_timeout = found.remote_bridge_idle_timeout;
+                return Ok(Some(candidate));
+            }
+        }
+    }
+    Ok(None)
+}
