+
+    fn dialer(options: Option<&ManagedSshOptions>, noninteractive: bool) -> SshLegDialer {
+        SshLegDialer::new(
+            "user@host".into(),
+            &RemoteHerdr::for_platform(linux()),
+            "work",
+            options,
+            noninteractive,
+        )
