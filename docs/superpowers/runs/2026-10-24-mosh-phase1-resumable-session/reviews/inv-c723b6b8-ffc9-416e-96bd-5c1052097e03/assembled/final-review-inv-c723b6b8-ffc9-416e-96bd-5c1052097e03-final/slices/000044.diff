+
+    #[test]
+    fn dial_returns_leg_with_bytes_after_marker() {
+        let script = ready_script("printf abc; exec cat");
+        let stop = AtomicBool::new(false);
+        let mut leg = dialer(None, false)
+            .dial_command(sh(&script), LegKind::Reconnect, None, &stop)
+            .unwrap();
+        let mut reader = leg.take_reader().unwrap();
+        let mut buf = [0u8; 3];
+        reader.read_exact(&mut buf).unwrap();
+        assert_eq!(&buf, b"abc");
+        let mut writer = leg.take_writer().unwrap();
+        writer.write_all(b"xy").unwrap();
+        writer.flush().unwrap();
+        let mut echo = [0u8; 2];
+        reader.read_exact(&mut echo).unwrap();
+        assert_eq!(&echo, b"xy");
+        drop((reader, writer));
+        leg.finish(true);
+    }
