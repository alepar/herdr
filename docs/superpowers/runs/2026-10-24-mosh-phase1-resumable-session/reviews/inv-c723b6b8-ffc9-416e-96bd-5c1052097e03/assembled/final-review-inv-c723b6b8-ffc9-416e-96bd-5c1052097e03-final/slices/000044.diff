+    // ---- classification --------------------------------------------------------------------
+
+    #[derive(Debug, PartialEq, Eq, Clone, Copy)]
+    enum Class {
+        Retryable,
+        Fatal,
+        Unsupported,
+    }
+
+    fn class(error: LegError) -> Class {
+        match error {
+            LegError::Retryable(_) => Class::Retryable,
+            LegError::Fatal(_) => Class::Fatal,
+            LegError::Unsupported(_) => Class::Unsupported,
+        }
+    }
+
+    fn report(code: Option<i32>, stderr: &str) -> LegEndReport {
+        LegEndReport {
+            exit_status: code.map(|c| ExitStatus::from_raw(c << 8)),
+            stderr: Some(stderr.to_owned()),
+            ..LegEndReport::default()
+        }
+    }
+
+    fn killed() -> LegEndReport {
+        LegEndReport {
+            exit_status: Some(ExitStatus::from_raw(libc::SIGKILL)),
+            stderr: Some(String::new()),
+            killed_by_bridge: true,
+            ..LegEndReport::default()
+        }
+    }
+
+    fn with_end(mut end: LegEndReport, reason: &str) -> LegEndReport {
+        end.pre_welcome_end = Some(reason.into());
+        end
+    }
+
+    fn with_welcome(mut end: LegEndReport) -> LegEndReport {
+        end.welcome_reached = true;
+        end
+    }
+
+    #[test]
+    fn classification_table() {
+        use Class::{Fatal, Retryable, Unsupported};
+        use LegKind::{Initial, Reconnect};
+        let cases: Vec<(&str, LegEndReport, Class, Class)> = vec![
+            ("255 permission denied", report(Some(255), "x: Permission denied (publickey)"), Fatal, Fatal),
+            ("255 host key", report(Some(255), "Host key verification failed."), Fatal, Fatal),
+            ("255 other", report(Some(255), "ssh: connect to host h: Connection timed out"), Fatal, Retryable),
+            ("non-255 exit", report(Some(1), "unsupported remote client bridge option"), Unsupported, Fatal),
+            ("generation mismatch exit", report(Some(2), "generation mismatch"), Unsupported, Fatal),
+            ("bridge-killed", killed(), Unsupported, Retryable),
+            ("attacher END", with_end(report(Some(0), ""), "keeper-unavailable"), Unsupported, Fatal),
+            ("EOF exit 0", report(Some(0), ""), Unsupported, Retryable),
+            ("EOF no status", LegEndReport::default(), Unsupported, Retryable),
+            ("255 beats END", with_end(report(Some(255), "Permission denied"), "keeper-unavailable"), Fatal, Fatal),
+            ("255 other beats END", with_end(report(Some(255), "timed out"), "keeper-unavailable"), Fatal, Retryable),
+            ("END beats remote exit", with_end(report(Some(3), ""), "protocol-version"), Unsupported, Fatal),
+            ("post-WELCOME exit 255", with_welcome(report(Some(255), "Permission denied")), Retryable, Retryable),
+            ("post-WELCOME exit 1", with_welcome(report(Some(1), "")), Retryable, Retryable),
+            ("post-WELCOME killed", with_welcome(killed()), Retryable, Retryable),
+        ];
+        for (name, end, leg0, reconnect) in cases {
+            assert_eq!(class(classify_leg(Initial, &end)), leg0, "leg 0: {name}");
+            assert_eq!(
+                class(classify_leg(Reconnect, &end)),
+                reconnect,
+                "reconnect: {name}"
+            );
+        }
+    }
+
+    #[test]
+    fn leg_zero_255_keeps_todays_message() {
+        let end = report(Some(255), "Permission denied (publickey).\n");
+        let LegError::Fatal(err) = classify_leg(LegKind::Initial, &end) else {
+            panic!("expected Fatal");
+        };
+        let expected = attach::ssh_bridge_exit_error(end.exit_status.unwrap(), b"Permission denied (publickey).\n");
+        assert_eq!(err.to_string(), expected.to_string());
+        assert_eq!(err.kind(), expected.kind());
+    }
