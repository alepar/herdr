+            if !interactive {
+                attach::apply_noninteractive_ssh_options(&mut expected);
+            }
+            expected
+                .arg("-T")
+                .arg("user@host")
+                .arg(&dialer.remote_command);
+            let actual = dialer.leg_command(LegKind::Initial);
+            assert_eq!(args(&actual), args(&expected));
+            assert_eq!(actual.get_program(), expected.get_program());
+            assert!(!args(&actual).iter().any(|a| a == "ControlPath=none"));
+        }
+    }
