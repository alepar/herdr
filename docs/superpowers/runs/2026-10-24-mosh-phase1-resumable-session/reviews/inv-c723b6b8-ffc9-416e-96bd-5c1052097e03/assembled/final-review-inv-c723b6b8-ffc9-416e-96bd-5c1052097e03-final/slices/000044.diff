+    #[test]
+    fn dial_eof_before_marker_is_classified_from_exit() {
+        let stop = AtomicBool::new(false);
+        let d = dialer(None, true);
+        let fatal = d.dial_command(sh("echo Permission denied >&2; exit 255"), LegKind::Reconnect, None, &stop);
+        assert!(matches!(fatal, Err(LegError::Fatal(_))));
+        let leg0 = d.dial_command(sh("exit 3"), LegKind::Initial, None, &stop);
+        assert!(matches!(leg0, Err(LegError::Unsupported(_))));
+        let eof = d.dial_command(sh("exit 0"), LegKind::Reconnect, None, &stop);
+        assert!(matches!(eof, Err(LegError::Retryable(_))));
+    }
