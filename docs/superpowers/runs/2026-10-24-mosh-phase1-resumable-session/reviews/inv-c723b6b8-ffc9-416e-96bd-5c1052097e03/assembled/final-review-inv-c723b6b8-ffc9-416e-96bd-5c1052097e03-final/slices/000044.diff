+    #[test]
+    fn dial_stop_kills_child_and_is_retryable() {
+        let stop = Arc::new(AtomicBool::new(false));
+        let flag = Arc::clone(&stop);
+        let setter = thread::spawn(move || {
+            thread::sleep(Duration::from_millis(200));
+            flag.store(true, Ordering::SeqCst);
+        });
+        let started = Instant::now();
+        let result =
+            dialer(None, false).dial_command(sh("exec sleep 30"), LegKind::Reconnect, None, &stop);
+        setter.join().unwrap();
+        assert!(matches!(result, Err(LegError::Retryable(_))));
+        assert!(started.elapsed() < Duration::from_secs(1));
+    }
+
+    #[test]
+    fn dial_setup_deadline_kills_child_and_is_retryable() {
+        let stop = AtomicBool::new(false);
+        let started = Instant::now();
+        let deadline = started + Duration::from_millis(300);
+        let result = dialer(None, false).dial_command(
+            sh("exec sleep 30"),
+            LegKind::Reconnect,
+            Some(deadline),
+            &stop,
+        );
+        assert!(matches!(result, Err(LegError::Retryable(_))));
+        let elapsed = started.elapsed();
+        assert!(elapsed >= Duration::from_millis(300) && elapsed < Duration::from_secs(1));
+    }
