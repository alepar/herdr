+    #[test]
+    fn initial_command_matches_today() {
+        let options = managed();
+        for (opts, interactive) in [(Some(&options), true), (None, false)] {
+            let dialer = dialer(opts, !interactive);
+            let mut expected = Command::new("ssh");
