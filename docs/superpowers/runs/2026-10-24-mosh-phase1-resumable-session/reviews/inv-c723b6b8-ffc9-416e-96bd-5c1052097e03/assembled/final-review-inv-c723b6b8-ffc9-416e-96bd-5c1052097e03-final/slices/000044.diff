+
+    fn args(command: &Command) -> Vec<String> {
+        command
+            .get_args()
+            .map(|arg| arg.to_string_lossy().into_owned())
+            .collect()
+    }
+
+    fn has_pair(args: &[String], a: &str, b: &str) -> bool {
+        args.windows(2).any(|pair| pair[0] == a && pair[1] == b)
+    }
+
+    fn assert_reconnect_bypasses_master(options: Option<&ManagedSshOptions>) {
+        let command = dialer(options, false).leg_command(LegKind::Reconnect);
+        let args = args(&command);
+        assert!(has_pair(&args, "-o", "BatchMode=yes"), "{args:?}");
+        assert!(has_pair(&args, "-o", "ConnectTimeout=10"), "{args:?}");
+        let noninteractive = args.iter().position(|a| a == "BatchMode=yes").unwrap();
+        let none = args.iter().position(|a| a == "ControlPath=none").unwrap();
+        assert!(none > noninteractive);
+        assert_eq!(args[none - 1], "-o");
+        assert!(has_pair(&args, "-o", "ControlMaster=no"), "{args:?}");
+        assert!(!args.iter().any(|a| a == "-S"), "{args:?}");
+        assert!(!args.iter().any(|a| a == "ControlMaster=auto"), "{args:?}");
+        assert!(command
+            .get_envs()
+            .all(|(key, _)| key != "LC_ALL"));
+        assert_eq!(args[args.len() - 3], "-T");
+        assert_eq!(args[args.len() - 2], "user@host");
+    }
+
